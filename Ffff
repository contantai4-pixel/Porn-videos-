    <!-- Video Edit Modal -->
    <div id="videoEditModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl" onclick="event.stopPropagation();">
            <h3 class="text-lg font-bold text-white border-b border-slate-800 pb-3" id="videoEditTitle">ভিডিও সম্পাদন করুন</h3>
            <input type="hidden" id="editVideoIndex">
            
            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">ভিডিও টাইটেল</label>
                <input type="text" id="editTitle" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500">
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">ভিডিও লিংক (Direct MP4 URL)</label>
                <input type="text" id="editVideoUrl" placeholder="https://example.com/video.mp4" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500">
                <p class="text-[11px] text-slate-500 mt-1">অথবা লোকাল ফাইল সিলেক্ট করুন:</p>
                <input type="file" id="editVideoFile" accept="video/*" class="mt-1 text-xs text-slate-400 file:mr-4 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-300 hover:file:bg-slate-700">
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">থাম্বনেইল ইমেজ URL</label>
                <input type="text" id="editThumbUrl" placeholder="https://example.com/image.jpg" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500">
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">বিবরণ (Description)</label>
                <textarea id="editDesc" rows="2" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-500"></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
                <button id="cancelVideoEdit" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-medium rounded-lg">বাতিল</button>
                <button id="saveVideoEdit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg">সংরক্ষণ করুন</button>
            </div>
        </div>
    </div>

    <!-- Application Logic -->
    <script>
        // Initial Default State
        const defaultState = {
            siteName: "My Stream Site",
            directLinkUrl: "https://www.google.com", // Replace with your Adsterra direct link
            timerDuration: 10,
            bgClickEnabled: true,
            videos: [
                {
                    title: "HD Action Movie Scene 01",
                    videoUrl: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
                    thumbUrl: "https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=800&q=80",
                    description: "High quality blockbuster action scene full preview."
                },
                {
                    title: "Nature & Wildlife Trailer",
                    videoUrl: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4",
                    thumbUrl: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80",
                    description: "Amazing nature video clip in 4K resolution."
                },
                {
                    title: "Cinematic Sci-Fi Montage",
                    videoUrl: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4",
                    thumbUrl: "https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?auto=format&fit=crop&w=800&q=80",
                    description: "Futuristic visual presentation scene."
                }
            ]
        };

        // App State
        let state = JSON.parse(localStorage.getItem('adsterra_portal_config')) || defaultState;
        let selectedVideoToPlay = null;
        let countdownInterval = null;

        // Save State helper
        function saveState() {
            localStorage.setItem('adsterra_portal_config', JSON.stringify(state));
            renderUI();
        }

        // Render Page UI
        function renderUI() {
            // Title & Branding
            document.getElementById('siteLogoName').textContent = state.siteName;
            document.getElementById('footerSiteName').textContent = state.siteName;

            // Render Video Grid
            const videoGrid = document.getElementById('videoGrid');
            videoGrid.innerHTML = '';

            state.videos.forEach((vid, index) => {
                const card = document.createElement('div');
                card.className = "group bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:border-slate-700 transition-all duration-300 flex flex-col";
                card.innerHTML = `
                    <div class="relative aspect-video bg-slate-950 overflow-hidden cursor-pointer">
                        <img src="${vid.thumbUrl || 'https://placehold.co/600x400/1e293b/ffffff?text=Video+' + (index+1)}" 
                             alt="${vid.title}" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=No+Thumbnail'">
                        <div class="absolute inset-0 bg-slate-950/40 group-hover:bg-slate-950/20 transition-all duration-300 flex items-center justify-center">
                            <button onclick="handleVideoPlayClick(${index})" class="w-14 h-14 rounded-full bg-brand-600/90 group-hover:bg-brand-500 text-white flex items-center justify-center text-xl shadow-xl transform group-hover:scale-110 transition-all duration-300">
                                <i class="fa-solid fa-play ml-1"></i>
                            </button>
                        </div>
                    </div>
                    <div class="p-4 flex-grow flex flex-col justify-between">
                        <div>
                            <h3 class="font-bold text-white text-base line-clamp-1 mb-1">${vid.title}</h3>
                            <p class="text-slate-400 text-xs line-clamp-2">${vid.description || 'no description available'}</p>
                        </div>
                        <button onclick="handleVideoPlayClick(${index})" class="mt-4 w-full py-2 bg-slate-800 hover:bg-brand-600 text-slate-200 hover:text-white rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors duration-200">
                            <i class="fa-solid fa-circle-play"></i>
                            <span>ভিডিওটি দেখুন</span>
                        </button>
                    </div>
                `;
                videoGrid.appendChild(card);
            });
        }

        // Handle Video Play Trigger
        function handleVideoPlayClick(index) {
            selectedVideoToPlay = state.videos[index];
            if (!selectedVideoToPlay) return;

            // 1. Open Direct Link in New Tab
            if (state.directLinkUrl) {
                window.open(state.directLinkUrl, '_blank');
            }

            // 2. Show 10-Second Verification Overlay
            showLockOverlay();
        }

        // Show Lock Countdown Overlay
        function showLockOverlay() {
            const overlay = document.getElementById('directLinkOverlay');
            const timerEl = document.getElementById('overlayTimerSec');
            const progressBar = document.getElementById('overlayProgressBar');
            
            let remaining = parseInt(state.timerDuration) || 10;
            const total = remaining;

            timerEl.textContent = remaining;
            progressBar.style.width = '0%';
            overlay.classList.remove('hidden');

            if (countdownInterval) clearInterval(countdownInterval);

            countdownInterval = setInterval(() => {
                remaining--;
                timerEl.textContent = remaining;
                const pct = ((total - remaining) / total) * 100;
                progressBar.style.width = `${pct}%`;

                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                    overlay.classList.add('hidden');
                    openVideoPlayer(selectedVideoToPlay);
                }
            }, 1000);
        }

        // Open Actual Video Player Modal
        function openVideoPlayer(videoObj) {
            const modal = document.getElementById('videoPlayerModal');
            const player = document.getElementById('mainVideoPlayer');
            
            document.getElementById('modalVideoTitle').textContent = videoObj.title;
            document.getElementById('modalVideoDesc').textContent = videoObj.description;
            
            player.src = videoObj.videoUrl;
            modal.classList.remove('hidden');
            player.play();
        }

        // Close Video Player Modal
        document.getElementById('closeVideoModal').addEventListener('click', () => {
            const modal = document.getElementById('videoPlayerModal');
            const player = document.getElementById('mainVideoPlayer');
            player.pause();
            player.src = "";
            modal.classList.add('hidden');
        });

        // Manual Direct Link Button inside overlay
        document.getElementById('manualDirectLinkBtn').addEventListener('click', () => {
            if (state.directLinkUrl) {
                window.open(state.directLinkUrl, '_blank');
            }
        });

        // Background Click Redirect Feature
        document.getElementById('appBody').addEventListener('click', (e) => {
            // Check if clicking background and feature is enabled
            if (state.bgClickEnabled && state.directLinkUrl) {
                window.open(state.directLinkUrl, '_blank');
            }
        });

        // Admin Modal Logic
        const adminModal = document.getElementById('adminModal');
        document.getElementById('adminBtn').addEventListener('click', () => {
            // Populate form
            document.getElementById('settingSiteName').value = state.siteName;
            document.getElementById('settingDirectLink').value = state.directLinkUrl;
            document.getElementById('settingTimer').value = state.timerDuration;
            document.getElementById('settingBgClick').checked = state.bgClickEnabled;

            renderAdminVideoList();
            adminModal.classList.remove('hidden');
        });

        document.getElementById('closeAdminModal').addEventListener('click', () => {
            adminModal.classList.add('hidden');
        });

        // Render Admin Video Slot Items
        function renderAdminVideoList() {
            const container = document.getElementById('adminVideoList');
            container.innerHTML = '';

            state.videos.forEach((vid, i) => {
                const item = document.createElement('div');
                item.className = "flex items-center justify-between bg-slate-800 p-3 rounded-xl border border-slate-700/60";
                item.innerHTML = `
                    <div class="flex items-center gap-3 overflow-hidden">
                        <span class="text-xs font-bold bg-slate-700 text-slate-300 w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0">${i + 1}</span>
                        <div class="truncate">
                            <h5 class="text-xs font-semibold text-white truncate">${vid.title}</h5>
                            <p class="text-[10px] text-slate-400 truncate">${vid.videoUrl}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <button onclick="openVideoEditModal(${i})" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs rounded-md">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button onclick="deleteVideo(${i})" class="px-2.5 py-1 bg-rose-900/40 hover:bg-rose-900/80 text-rose-300 text-xs rounded-md">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        // Video Edit/Add Flow
        const videoEditModal = document.getElementById('videoEditModal');

        function openVideoEditModal(index = null) {
            document.getElementById('editVideoIndex').value = index !== null ? index : '';
            if (index !== null) {
                const vid = state.videos[index];
                document.getElementById('videoEditTitle').textContent = "ভিডিও সম্পাদন করুন";
                document.getElementById('editTitle').value = vid.title;
                document.getElementById('editVideoUrl').value = vid.videoUrl;
                document.getElementById('editThumbUrl').value = vid.thumbUrl;
                document.getElementById('editDesc').value = vid.description;
            } else {
                document.getElementById('videoEditTitle').textContent = "নতুন ভিডিও যোগ করুন";
                document.getElementById('editTitle').value = "";
                document.getElementById('editVideoUrl').value = "";
                document.getElementById('editThumbUrl').value = "";
                document.getElementById('editDesc').value = "";
            }
            document.getElementById('editVideoFile').value = "";
            videoEditModal.classList.remove('hidden');
        }

        document.getElementById('addNewVideoBtn').addEventListener('click', () => {
            if (state.videos.length >= 10) {
                alert("সর্বোচ্চ ১০ টি ভিডিও আপলোড/যোগ করতে পারবেন।");
                return;
            }
            openVideoEditModal(null);
        });

        document.getElementById('cancelVideoEdit').addEventListener('click', () => {
            videoEditModal.classList.add('hidden');
        });

        // File upload local blob URL handler
        document.getElementById('editVideoFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const blobUrl = URL.createObjectURL(file);
                document.getElementById('editVideoUrl').value = blobUrl;
            }
        });

        document.getElementById('saveVideoEdit').addEventListener('click', () => {
            const idx = document.getElementById('editVideoIndex').value;
            const title = document.getElementById('editTitle').value || "Untitled Video";
            const videoUrl = document.getElementById('editVideoUrl').value || "";
            const thumbUrl = document.getElementById('editThumbUrl').value || "";
            const description = document.getElementById('editDesc').value || "";

            const videoData = { title, videoUrl, thumbUrl, description };

            if (idx !== '') {
                state.videos[parseInt(idx)] = videoData;
            } else {
                state.videos.push(videoData);
            }

            renderAdminVideoList();
            videoEditModal.classList.add('hidden');
        });

        function deleteVideo(index) {
            state.videos.splice(index, 1);
            renderAdminVideoList();
        }

        // Save Admin Settings
        document.getElementById('saveSettingsBtn').addEventListener('click', () => {
            state.siteName = document.getElementById('settingSiteName').value || "My Stream Site";
            state.directLinkUrl = document.getElementById('settingDirectLink').value;
            state.timerDuration = parseInt(document.getElementById('settingTimer').value) || 10;
            state.bgClickEnabled = document.getElementById('settingBgClick').checked;

            saveState();
            adminModal.classList.add('hidden');
        });

        // Initialize on Load
        window.onload = function() {
            renderUI();
        };
    </script>
</body>
</html>
